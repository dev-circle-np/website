---
const logoUrl = "/images/logo.png";
const discordUrl = "https://discord.gg/fp5CmBG";
const eventsUrl = "https://events.asy.sh";
---

<header class="site-header" aria-label="Site header">
  <div class="site-header-inner container">
    <a href="/" class="brand" aria-label="Developers Circle Nepal home">
      <img src={logoUrl} alt="Developers Circle Nepal logo" width="48" height="48" />
      <span>Developers Circle Nepal</span>
    </a>
    <nav class="site-nav" aria-label="Primary navigation">
      <a href="/members">Members</a>
      <a class="nav-events" href={eventsUrl} target="_blank" rel="noreferrer">Events</a>
      <a
        class="nav-discord"
        href={discordUrl}
        target="_blank"
        rel="noreferrer"
        aria-label="Join Discord"
      >
        <img src="/images/discord.svg" alt="Discord logo" width="18" height="18" />
        <span>Join Discord</span>
      </a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: absolute;
    z-index: 10;
    top: clamp(1rem, 3vw, 2rem);
    right: 0;
    left: 0;
  }

  .site-header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .brand,
  .site-nav a {
    text-decoration: none;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
    color: var(--ink);
    font-size: 0.95rem;
    font-weight: 700;
    text-shadow: 0 2px 18px rgb(0 0 0 / 0.4);
  }

  .brand img {
    width: clamp(2.7rem, 4vw, 3.5rem);
    height: clamp(2.7rem, 4vw, 3.5rem);
    border-radius: 999px;
    box-shadow: 0 10px 34px rgb(0 0 0 / 0.3);
  }

  .site-nav {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: clamp(0.7rem, 1.7vw, 1.25rem);
  }

  .site-nav a {
    color: var(--text);
    font-size: clamp(0.82rem, 1vw, 0.92rem);
    font-weight: 700;
    line-height: 1;
    text-shadow: 0 2px 18px rgb(0 0 0 / 0.42);
    transition: color 180ms var(--ease-out-quint);
  }

  .site-nav a:hover {
    color: var(--gold);
  }

  /*
   * The header keeps its own compact button rather than the shared .btn: it is
   * sized to sit inside the bar, not to stand alone in a content column.
   */
  .site-nav .nav-discord {
    min-height: 2.75rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0 1rem;
    border: 1px solid var(--hairline-loud);
    border-radius: 999px;
    background: var(--fill);
    color: var(--ink);
    box-shadow: inset 0 1px 0 var(--hairline-strong);
    backdrop-filter: blur(14px) saturate(130%);
    -webkit-backdrop-filter: blur(14px) saturate(130%);
  }

  .site-nav .nav-discord img {
    width: 1.05rem;
    height: 1.05rem;
    flex: 0 0 auto;
    margin-right: 0.35rem;
  }

  .site-nav .nav-discord:hover {
    background: var(--fill-hover);
    color: var(--gold);
  }

  @media (max-width: 640px) {
    .site-header-inner {
      gap: 0.85rem;
    }

    .brand span {
      display: none;
    }

    .site-nav {
      gap: 0.65rem;
    }

    .site-nav a {
      font-size: 0.8rem;
    }

    .site-nav .nav-discord {
      min-height: 2.45rem;
      padding: 0 0.72rem;
    }
  }

  @media (max-width: 460px) {
    .site-nav {
      gap: 0.55rem;
    }

    .site-nav .nav-discord {
      width: 2.65rem;
      padding: 0;
    }

    .site-nav .nav-discord img {
      margin-right: 0;
    }

    .site-nav .nav-discord span {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }
  }
</style>
